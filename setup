#!/bin/bash

# Text colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}====== Raspberry Pi Camera Setup Script ======${NC}"
echo -e "${YELLOW}This script will help set up your camera for drowning detection${NC}"
echo

# Check if running as root
if [ "$(id -u)" -ne 0 ]; then
    echo -e "${RED}This script should be run as root. Please use sudo.${NC}"
    echo -e "Try: ${YELLOW}sudo bash setup_camera.sh${NC}"
    exit 1
fi

# Function to print status messages
status() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Check Raspberry Pi OS version
status "Checking Raspberry Pi OS version..."
if [ -f /etc/os-release ]; then
    . /etc/os-release
    echo "OS: $PRETTY_NAME"
else
    warning "Could not determine OS version"
fi

# Check if camera interface is enabled
status "Checking if camera interface is enabled..."
CAMERA_ENABLED=$(vcgencmd get_camera)
echo "Camera status: $CAMERA_ENABLED"

if [[ $CAMERA_ENABLED == *"supported=0"* ]]; then
    warning "Camera support not available on this Raspberry Pi model"
elif [[ $CAMERA_ENABLED == *"detected=0"* ]]; then
    warning "Camera is not detected. Check your camera connection"
    echo "Enabling camera interface..."
    raspi-config nonint do_camera 0
    warning "You may need to reboot for changes to take effect"
fi

# Install required packages
status "Installing required packages..."
apt-get update

echo "Installing camera libraries..."
apt-get install -y python3-picamera2 python3-opencv libopencv-dev v4l-utils

# Add user to video group
status "Adding user to video group..."
usermod -a -G video $USER
usermod -a -G video pi

# Check for video devices
status "Checking for video devices..."
ls -l /dev/video* 2>/dev/null || echo "No video devices found"

# Test camera access with libcamera
status "Testing camera with libcamera-still..."
if libcamera-still -t 1000 -o /tmp/test_camera.jpg 2>/dev/null; then
    status "Camera test successful! Image saved to /tmp/test_camera.jpg"
else
    error "Camera test failed. Please check your camera connection"
fi

# Install Python dependencies
status "Installing Python dependencies..."
pip3 install --upgrade pip
pip3 install ultralytics opencv-python-headless numpy

# Create test script
status "Creating a simple test script..."
cat > /home/pi/test_camera.py << 'EOF'
#!/usr/bin/env python3
import time
import cv2

def test_opencv():
    print("Testing OpenCV camera access...")
    for i in range(3):
        print(f"Trying camera index {i}...")
        cap = cv2.VideoCapture(i)
        if cap.isOpened():
            ret, frame = cap.read()
            if ret:
                cv2.imwrite(f"opencv_test_{i}.jpg", frame)
                print(f"Success! Saved image to opencv_test_{i}.jpg")
                cap.release()
                return True
            cap.release()
    return False

def test_picamera2():
    try:
        from picamera2 import Picamera2
        print("Testing PiCamera2...")
        picam2 = Picamera2()
        config = picam2.create_preview_configuration()
        picam2.configure(config)
        picam2.start()
        time.sleep(2)  # Give camera time to warm up
        frame = picam2.capture_array()
        picam2.close()
        
        if frame is not None:
            import cv2
            cv2.imwrite("picamera2_test.jpg", frame)
            print("Success! Saved image to picamera2_test.jpg")
            return True
        else:
            print("Failed to capture frame with PiCamera2")
            return False
    except ImportError:
        print("PiCamera2 not available")
        return False
    except Exception as e:
        print(f"Error with PiCamera2: {e}")
        return False

if __name__ == "__main__":
    print("=== Camera Test Script ===")
    
    opencv_success = test_opencv()
    picam2_success = test_picamera2()
    
    if opencv_success:
        print("✓ OpenCV camera access working")
    else:
        print("✗ OpenCV camera access failed")
        
    if picam2_success:
        print("✓ PiCamera2 access working")
    else:
        print("✗ PiCamera2 access failed")
        
    if not opencv_success and not picam2_success:
        print("\nNo camera access methods are working.")
        print("Try rebooting your Raspberry Pi.")
    else:
        print("\nAt least one camera access method is working!")
        print("You can now run your drowning detection script.")
EOF

# Make test script executable
chmod +x /home/pi/test_camera.py
chown pi:pi /home/pi/test_camera.py

# Final instructions
echo
echo -e "${GREEN}====== Setup Complete ======${NC}"
echo
echo -e "${YELLOW}Next steps:${NC}"
echo "1. Reboot your Raspberry Pi: sudo reboot"
echo "2. Run the test script to verify camera access: python3 /home/pi/test_camera.py"
echo "3. Run your drowning detection script: python3 libcamera_drowning_detector.py"
echo
echo -e "${YELLOW}If you still have issues after rebooting:${NC}"
echo "- Check your camera connection"
echo "- Try 'libcamera-still -o test.jpg' to test the camera directly"
echo "- Try different camera interfaces in your Python script"
echo
